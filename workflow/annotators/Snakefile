            """
            mkdir -p $(dirname {output.out})
            mkdir -p $(dirname {log})
            {params.cmd} 2> {log}
            """

if BATCH_KAIJU:
    for _kaiju_run in KAIJU_RUNS:
        rule:
            name:
                f"kaiju_multi_{_kaiju_run}"
            output:
                expand(
                    f"{config['output_dir']}/{{sample}}_{_kaiju_run}.kaiju.out",
                    sample=SAMPLES,
                )
            threads:
                THREADS.get(_kaiju_run, 1)
            resources:
                mem_mb=annotator_mem_mb(
                    "kaiju", THREADS.get(_kaiju_run, 1), MACHINE_CORES, MEM_LIMIT
                ),
            priority: annotator_priority("kaiju")
            log:
                f"{config['output_dir']}/logs/{_kaiju_run}.kaiju-multi.log"
            params:
                cmd = lambda wildcards, output, run_name=_kaiju_run: ANNOTATORS[run_name].batch_shell(
                    SAMPLES, config["r1_dir"], config["r2_dir"], config["output_dir"]
                )
            shell:
                """
                mkdir -p $(dirname {log})
                {params.cmd} 2> {log}
                """

rule metaphlan4:
    input:
        r1 = r1_input,
        r2 = r2_input
    output:
        out = f"{config['output_dir']}/{{sample}}_{{run_name}}.metaphlan4.out",
        raw = f"{config['output_dir']}/{{sample}}_{{run_name}}.metaphlan4.raw",
        bowtie = f"{config['output_dir']}/{{sample}}_{{run_name}}.bowtie2.bz2"
    threads:
        lambda wildcards: THREADS.get(wildcards.run_name, 1)
    resources:
        mem_mb=rule_mem,
    priority: annotator_priority("metaphlan4")
    log:
        f"{config['output_dir']}/logs/{{sample}}_{{run_name}}.metaphlan4.log"
    params:
        cmd = lambda wildcards, input, output: ANNOTATORS[wildcards.run_name].get_snakemake_shell_cmd(
            input.r1, shell_r2(wildcards, input), [output.out, output.raw, output.bowtie]
        )
    shell:
        """
        mkdir -p $(dirname {output.out})
        mkdir -p $(dirname {log})
        {params.cmd} 2> {log}
        """

