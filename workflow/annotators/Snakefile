import os

from samovar.annotators_wrapper import get_annotator_instance, use_kaiju_multi
from samovar.memory import annotator_mem_mb
from samovar.tool_spec import annotator_priority
from samovar.seqio import find_fastq_mate, list_fastq_samples

try:
    workflow.rerun_triggers = ["mtime"]
except Exception:
    pass

# Get all samples from input directories (plain or gzipped FASTQ / FQ)
def get_samples():
    return list_fastq_samples(config["r1_dir"])

def r1_input(wildcards):
    found = find_fastq_mate(config["r1_dir"], wildcards.sample, "R1")
    path = str(found) if found else os.path.join(config["r1_dir"], f"{wildcards.sample}_R1.fastq")
    return ancient(path)

def r2_input(wildcards):
    # Single-end samples have no mate. [] is not an input, so Snakemake does
    # not require sample_*_R2.fastq. shell_r2 then returns "" and the command
    # is built without paired flags.
    found = find_fastq_mate(config["r2_dir"], wildcards.sample, "R2")
    if found is None:
        return []
    return ancient(str(found))


def shell_r2(wildcards, snakemake_input):
    """Mate path when the sample is paired; empty string when it is single-end.

    An empty string is not a missing file. Annotator commands omit paired flags.
    """
    del wildcards
    raw = getattr(snakemake_input, "r2", "")
    if isinstance(raw, (list, tuple)):
        raw = raw[0] if raw else ""
    text = str(raw or "")
    if text and os.path.isfile(text):
        return text
    return ""

SAMPLES = get_samples()

# Initialize annotator instances and thread counts once during DAG generation
ANNOTATORS = {}
THREADS = {}
TOOL_TYPES = {}
for run_conf in config.get('run_config', []):
    run_name = run_conf['run_name']
    tool_type = run_conf['type']
    ANNOTATORS[run_name] = get_annotator_instance(tool_type, run_conf, config)
    THREADS[run_name] = run_conf.get('threads', 1)
    TOOL_TYPES[run_name] = str(tool_type or run_name)

MACHINE_CORES = max(1, int(config.get("cores") or os.environ.get("SAMOVAR_CORES") or 1))
MEM_LIMIT = int(config.get("mem_mb") or os.environ.get("SAMOVAR_MEM_MB") or 0) or None


def rule_mem(wildcards):
    tool = TOOL_TYPES.get(wildcards.run_name, "")
    return annotator_mem_mb(
        tool, THREADS.get(wildcards.run_name, 1), MACHINE_CORES, MEM_LIMIT
    )


# custom_tool is one rule for every custom annotator. If MetaX is among them,
# the rule takes MetaX's priority so that database job is not stuck behind
# per-read tools. Snakemake priority has to be a number, not a function.
CUSTOM_PRIORITY = max(
    (
        annotator_priority(tool)
        for name, tool in TOOL_TYPES.items()
        if type(ANNOTATORS[name]).__name__ == "CustomAnnotator"
    ),
    default=annotator_priority("gc"),
)

KAIJU_RUNS = [
    name for name, ann in ANNOTATORS.items()
    if type(ann).__name__ == "KaijuAnnotator"
]
# One kaiju-multi job loads the FM-index once for the cohort. A wildcard
# rule that also writes the same files would be ambiguous, so it is omitted.
BATCH_KAIJU = use_kaiju_multi(len(SAMPLES)) and bool(KAIJU_RUNS)

def get_all_expected_outputs():
    outputs = []
    for run_name, annotator in ANNOTATORS.items():
        for sample in SAMPLES:
            expected_files = annotator.get_expected_outputs(sample, config['output_dir'])
            outputs.extend(expected_files)
    return outputs

rule all:
    input:
        get_all_expected_outputs()

# ==========================================
# UNIVERSAL RULE FOR ALL CUSTOM TOOLS
# ==========================================
rule custom_tool:
    input:
        r1 = r1_input,
        r2 = r2_input
    output:
        out = f"{config['output_dir']}/{{sample}}_{{run_name}}.custom_{{tool_name}}.out"
    threads:
        lambda wildcards: THREADS.get(wildcards.run_name, 1)
    resources:
        mem_mb=rule_mem,
    priority: CUSTOM_PRIORITY
    log:
        f"{config['output_dir']}/logs/{{sample}}_{{run_name}}.custom_{{tool_name}}.log"
    params:
        cmd = lambda wildcards, input, output: ANNOTATORS[wildcards.run_name].get_snakemake_shell_cmd(
            input.r1, shell_r2(wildcards, input), [output.out]
        )
    shell:
        """
        mkdir -p $(dirname {output.out})
        mkdir -p $(dirname {log})
        {params.cmd} 2> {log}
        """

# ==========================================
# NATIVE TOOLS
# ==========================================
rule assembly:
    input:
        r1 = r1_input,
        r2 = r2_input
    output:
        out = f"{config['output_dir']}/{{sample}}_{{run_name}}.assembly.out"
    threads:
        lambda wildcards: THREADS.get(wildcards.run_name, 1)
    resources:
        mem_mb=rule_mem,
    priority: annotator_priority("assembly")
    log:
        f"{config['output_dir']}/logs/{{sample}}_{{run_name}}.assembly.log"
    params:
        cmd = lambda wildcards, input, output: ANNOTATORS[wildcards.run_name].get_snakemake_shell_cmd(
            input.r1, shell_r2(wildcards, input), [output.out]
        )
    shell:
        """
        mkdir -p $(dirname {output.out})
        mkdir -p $(dirname {log})
        {params.cmd} 2> {log}
        """

rule kraken2:
    input:
        r1 = r1_input,
        r2 = r2_input
    output:
        report = f"{config['output_dir']}/{{sample}}_{{run_name}}.kraken2.report",
        out = f"{config['output_dir']}/{{sample}}_{{run_name}}.kraken2.out"
    threads:
        lambda wildcards: THREADS.get(wildcards.run_name, 1)
    resources:
        mem_mb=rule_mem,
    priority: annotator_priority("kraken2")
    log:
        f"{config['output_dir']}/logs/{{sample}}_{{run_name}}.kraken2.log"
    params:
        cmd = lambda wildcards, input, output: ANNOTATORS[wildcards.run_name].get_snakemake_shell_cmd(
            input.r1, shell_r2(wildcards, input), [output.report, output.out]
        )
    shell:
        """
        mkdir -p $(dirname {output.report})
        mkdir -p $(dirname {log})
        {params.cmd} 2> {log}
        """

if not BATCH_KAIJU:
    rule kaiju:
        input:
            r1 = r1_input,
            r2 = r2_input
        output:
            out = f"{config['output_dir']}/{{sample}}_{{run_name}}.kaiju.out"
        threads:
            lambda wildcards: THREADS.get(wildcards.run_name, 1)
        resources:
            mem_mb=rule_mem,
        priority: annotator_priority("kaiju")
