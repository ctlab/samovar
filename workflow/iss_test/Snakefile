import os
import glob

from samovar.table2iss import generate_iss_test_samples

configfile: "config.yaml"

if not config.get("genomes"):
    genome_files = glob.glob(os.path.join(config["genome_dir"], "*"))
    config["genomes"] = [
        os.path.basename(g)
        for g in genome_files
        if g.endswith((".fa", ".fna", ".fasta"))
    ]
    print(f"Found genomes: {config['genomes']}")

SAMPLES = [str(i) for i in range(1, config["n_samples"] + 1)]
OUTPUT_FILES = []
for sample in SAMPLES:
    OUTPUT_FILES.append(f"{config['output_dir']}/{sample}_full_R1.fastq")
    OUTPUT_FILES.append(f"{config['output_dir']}/{sample}_full_R2.fastq")

rule all:
    input:
        OUTPUT_FILES

rule generate_full_metagenome_and_split:
    output:
        OUTPUT_FILES
    params:
        genome_dir = config["genome_dir"],
        host_genome = config["host_genome"],
        output_dir = config["output_dir"],
        n_samples = config["n_samples"],
        total_reads = config["total_reads"],
        host_fraction = config["host_fraction"],
        seed = config["seed"],
        model = config["model"],
        genomes = config["genomes"],
        cpus = int(config.get("cores", 2)),
    run:
        generate_iss_test_samples(
            genome_dir=params.genome_dir,
            host_genome=params.host_genome,
            output_dir=params.output_dir,
            n_samples=params.n_samples,
            total_reads=params.total_reads,
            host_fraction=params.host_fraction,
            seed=params.seed,
            model=params.model,
            genomes=params.genomes,
            cpus=params.cpus,
        )
