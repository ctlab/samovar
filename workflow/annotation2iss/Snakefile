import os
import glob
import logging

from samovar.regenerate import resolve_regeneration_mode, synthetic_sample_names
from samovar.table2iss import process_annotation_tables

# Set up logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Configuration
configfile: "config.yaml"

# Input and output directories
ANNOTATION_DIR = config["annotation_dir"]
GENOME_DIR = config["genome_dir"]
OUTPUT_DIR = config["output_dir"]
EMAIL = config["email"]
READ_LENGTH = config["read_length"]
COVERAGE = config["coverage"]
MODEL = config.get("model", "hiseq")
MAX_GENOMES = config.get("max_genomes", None)
CORES = int(config.get("cores", 2))
_MODE_RAW = config.get("table_reads_generator") or config.get("regeneration_mode", "direct")
if isinstance(_MODE_RAW, (list, tuple)):
    _MODE_RAW = _MODE_RAW[0] if _MODE_RAW else "direct"
_KIND, REGENERATION_MODE = resolve_regeneration_mode(_MODE_RAW)
REGENERATION_CONFIG = {
    "regeneration_mode": REGENERATION_MODE,
    "table_reads_generator": REGENERATION_MODE,
    "N_reads": int(config.get("N_reads", 1000)),
    "seed": config.get("seed", 42),
    "threshold_amount": config.get("threshold_amount", config.get("treshhold_amount", 1e-5)),
    "vae_latent_dim": config.get("vae_latent_dim", 4),
    "rescale_abundance": config.get("rescale_abundance", False),
    "bootstrap_error_scale": config.get("bootstrap_error_scale", 0.15),
    "min_cluster_size": config.get("min_cluster_size", 2),
    "max_cluster_size": config.get("max_cluster_size", 100),
}
_multi = config.get("table_reads_generators") or config.get("table_reads_generator")
if isinstance(_multi, (list, tuple)) and len(_multi) > 1:
    REGENERATION_CONFIG["table_reads_generators"] = list(_multi)
    REGENERATION_CONFIG["table_reads_generator"] = list(_multi)
if config.get("table_score"):
    REGENERATION_CONFIG["table_score"] = config.get("table_score")
REGENERATION_CONFIG["cores"] = CORES
if config.get("samples_metadata"):
    REGENERATION_CONFIG["samples_metadata"] = config["samples_metadata"]
if config.get("table_reads_generator_flags") or config.get("extra_flags"):
    REGENERATION_CONFIG["table_reads_generator_flags"] = (
        config.get("table_reads_generator_flags") or config.get("extra_flags")
    )
if config.get("reads_generator"):
    REGENERATION_CONFIG["reads_generator"] = config["reads_generator"]
if config.get("reads_generator_flags"):
    REGENERATION_CONFIG["reads_generator_flags"] = config["reads_generator_flags"]
if config.get("metagenome_generator"):
    REGENERATION_CONFIG["metagenome_generator"] = config["metagenome_generator"]
if config.get("metagenome_generator_flags"):
    REGENERATION_CONFIG["metagenome_generator_flags"] = config[
        "metagenome_generator_flags"
    ]
if config.get("N") not in (None, "", 0):
    REGENERATION_CONFIG["N"] = int(config["N"])
GZIP_GENOMES = bool(config.get("gzip_genomes", True))
GZIP_READS = bool(config.get("gzip_reads", False))
REANNOTATION_LEVEL = config.get("reannotation_level", "taxid")

# Create output directories
os.makedirs(OUTPUT_DIR, exist_ok=True)
os.makedirs(GENOME_DIR, exist_ok=True)

# Get list of annotation files
def get_annotation_files():
    files = glob.glob(os.path.join(ANNOTATION_DIR, "*.annotation.csv"))
    return files

# Get list of annotators from all annotation tables
def get_annotators():
    import pandas as pd

    annotation_files = get_annotation_files()
    if not annotation_files:
        logger.error("No annotation files found!")
        return []

    annotators = []
    for annotation_file in annotation_files:
        df = pd.read_csv(annotation_file)
        taxid_cols = [col for col in df.columns if col.startswith("taxID_")]
        for col in taxid_cols:
            parts = col.split("_")
            if len(parts) >= 2:
                annotator = parts[1]
                if annotator not in annotators:
                    annotators.append(annotator)
    return annotators

ANNOTATORS = get_annotators()
logger.info(f"Using annotators: {ANNOTATORS}")

def get_sample_names():
    annotation_files = get_annotation_files()
    original = []
    for file in annotation_files:
        sample_name = os.path.basename(file).split(".")[0]
        original.append(sample_name)
    if _KIND == "builtin" and REGENERATION_MODE == "direct":
        return original
    n_cfg = REGENERATION_CONFIG.get("N")
    n = int(n_cfg) if n_cfg not in (None, "", 0) else 0
    return synthetic_sample_names(original, n or None)

SAMPLES = get_sample_names()
logger.info(f"Using samples: {SAMPLES}")

DONE_MARKER = os.path.join(OUTPUT_DIR, ".process_annotations.done")

rule all:
    input:
        DONE_MARKER

rule process_annotations:
    input:
        annotation_files = get_annotation_files()
    output:
        DONE_MARKER
    params:
        genome_dir = GENOME_DIR,
        output_dir = OUTPUT_DIR,
        email = EMAIL,
        model = MODEL,
        read_length = READ_LENGTH,
        max_genomes = MAX_GENOMES,
        cpus = CORES,
        annotation_dir = ANNOTATION_DIR,
        regeneration_config = REGENERATION_CONFIG,
        seed = REGENERATION_CONFIG.get("seed", 42),
    run:
        try:
            process_annotation_tables(
                table_paths=list(input.annotation_files),
                genome_dir=params.genome_dir,
                output_dir=params.output_dir,
                email=params.email,
                reference_only=True,
                model=params.model,
                read_length=params.read_length,
                max_genomes=params.max_genomes,
                cpus=params.cpus,
                seed=params.seed,
                annotation_dir=params.annotation_dir,
                regeneration_config=params.regeneration_config,
                gzip_genomes=GZIP_GENOMES,
                gzip_reads=GZIP_READS,
                reannotation_level=REANNOTATION_LEVEL,
            )
            logger.info("Finished annotation2iss under %s", params.output_dir)
        except Exception as e:
            logger.error(f"Error processing annotations: {str(e)}")
            raise
        with open(str(output[0]), "w", encoding="utf-8") as handle:
            handle.write("ok\n")
