# Set up logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Configuration
configfile: "config.yaml"

# Input and output directories
ANNOTATION_DIR = config["annotation_dir"]
GENOME_DIR = config["genome_dir"]
OUTPUT_DIR = config["output_dir"]
EMAIL = config["email"]
READ_LENGTH = config["read_length"]
COVERAGE = config["coverage"]
MODEL = config.get("model", "hiseq")

# Create output directories
os.makedirs(OUTPUT_DIR, exist_ok=True)
os.makedirs(GENOME_DIR, exist_ok=True)

# Get list of annotation files
def get_annotation_files():
    return glob.glob(os.path.join(ANNOTATION_DIR, "*.annotation.csv"))

# Исправлено: извлекаем полное имя (например, assembly_hybrid), а не режем по первому подчёркиванию
def get_annotators():
    annotation_files = get_annotation_files()
    if not annotation_files:
        logger.error("No annotation files found!")
        return []
    
    df = pd.read_csv(annotation_files[0], sep='\t')
    taxid_cols = [col for col in df.columns if col.startswith('taxID_')]
    
    annotators = []
    for col in taxid_cols:
        # Регулярка один в один как в твоём Python-модуле
        match = re.search(r'taxID_(.*?)(?:_[0-9]*)?$', col)
        if match:
            annotator = match.group(1)
            if annotator not in annotators:
                annotators.append(annotator)
    return annotators

# Get all annotators
ANNOTATORS = get_annotators()
logger.info(f"Using annotators: {ANNOTATORS}")

# Get sample names from annotation files
def get_sample_names():
    annotation_files = get_annotation_files()
    return [os.path.basename(f).split('.')[0] for f in annotation_files]

SAMPLES = get_sample_names()
logger.info(f"Using samples: {SAMPLES}")

# Формируем список финальных файлов с учётом корректных имён инструментов
ALL_OUTPUT_FILES = []
for sample in SAMPLES:
    for annotator in ANNOTATORS:
        ALL_OUTPUT_FILES.append(os.path.join(OUTPUT_DIR, f"{sample}_{annotator}_R1.fastq"))
        ALL_OUTPUT_FILES.append(os.path.join(OUTPUT_DIR, f"{sample}_{annotator}_R2.fastq"))

logger.info(f"Generating {len(ALL_OUTPUT_FILES)} output files")

# Main rule to run the entire workflow
rule all:
    input:
        ALL_OUTPUT_FILES

# Исправлено: убран вайлдкард {annotator} из правила.
# Теперь Snakemake знает, что ОДИН запуск функции для семпла создаёт файлы СРАЗУ для всех инструментов.
