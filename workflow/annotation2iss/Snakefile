import os
import glob
import logging

from samovar.table2iss import process_annotation_tables

# Set up logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Configuration
configfile: "config.yaml"

# Input and output directories
ANNOTATION_DIR = config["annotation_dir"]
GENOME_DIR = config["genome_dir"]
OUTPUT_DIR = config["output_dir"]
EMAIL = config["email"]
READ_LENGTH = config["read_length"]
COVERAGE = config["coverage"]
MODEL = config.get("model", "hiseq")
MAX_GENOMES = config.get("max_genomes", None)
CORES = int(config.get("cores", 2))

# Create output directories
os.makedirs(OUTPUT_DIR, exist_ok=True)
os.makedirs(GENOME_DIR, exist_ok=True)

# Get list of annotation files
def get_annotation_files():
    files = glob.glob(os.path.join(ANNOTATION_DIR, "*.annotation.csv"))
    return files

# Get list of annotators from all annotation tables
def get_annotators():
    import pandas as pd

    annotation_files = get_annotation_files()
    if not annotation_files:
        logger.error("No annotation files found!")
        return []

    annotators = []
    for annotation_file in annotation_files:
        df = pd.read_csv(annotation_file)
        taxid_cols = [col for col in df.columns if col.startswith("taxID_")]
        for col in taxid_cols:
            parts = col.split("_")
            if len(parts) >= 2:
                annotator = parts[1]
                if annotator not in annotators:
                    annotators.append(annotator)
    return annotators

ANNOTATORS = get_annotators()
logger.info(f"Using annotators: {ANNOTATORS}")

def get_sample_names():
    sample_names = []
    for file in get_annotation_files():
        sample_name = os.path.basename(file).split(".")[0]
        sample_names.append(sample_name)
    return sample_names

SAMPLES = get_sample_names()
logger.info(f"Using samples: {SAMPLES}")

ALL_OUTPUT_FILES = []
for sample in SAMPLES:
    for annotator in ANNOTATORS:
        ALL_OUTPUT_FILES.append(os.path.join(OUTPUT_DIR, f"{sample}_{annotator}_R1.fastq"))
        ALL_OUTPUT_FILES.append(os.path.join(OUTPUT_DIR, f"{sample}_{annotator}_R2.fastq"))

logger.info(f"Generating {len(ALL_OUTPUT_FILES)} output files")

rule all:
    input:
        ALL_OUTPUT_FILES

rule process_annotations:
    input:
        annotation_files = get_annotation_files()
    output:
        ALL_OUTPUT_FILES
    params:
        genome_dir = GENOME_DIR,
        output_dir = OUTPUT_DIR,
        email = EMAIL,
        model = MODEL,
        read_length = READ_LENGTH,
        max_genomes = MAX_GENOMES,
        cpus = CORES,
    run:
        try:
            process_annotation_tables(
                table_paths=list(input.annotation_files),
                genome_dir=params.genome_dir,
                output_dir=params.output_dir,
                email=params.email,
                reference_only=True,
                model=params.model,
                read_length=params.read_length,
                max_genomes=params.max_genomes,
                cpus=params.cpus,
            )
            logger.info(
                "Generated a full metagenome per annotator and split it into %s samples",
                len(SAMPLES),
            )
        except Exception as e:
            logger.error(f"Error processing annotations: {str(e)}")
            raise
