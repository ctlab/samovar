#!/usr/bin/env python3

import sys
import argparse
from pathlib import Path
from samovar.config import DEFAULT_OUTPUT_DIR, setup_pipeline, parse_args
from samovar.genome_fetcher import argparse_max_genome_mb
from samovar.regenerate import argparse_max_genomes

def main():
    # Get the base parser
    parser = argparse.ArgumentParser(description='SamovaR Pipeline Configuration')
    
    # Input source (mutually exclusive)
    input_group = parser.add_mutually_exclusive_group(required=False)
    input_group.add_argument('--input_config', help='Path to input configuration file', required=False)
    input_group.add_argument('--input_dir', help='Directory containing input FASTQ files', required=False)
    
    # Output
    from samovar.paths import add_output_dir_argument

    add_output_dir_argument(
        parser,
        default=None,
        help='Output directory (default: samovar_out, or from --input_config)',
    )
    parser.add_argument('--cores', type=int, default=1, help='Number of cores for snakemake / annotator threads')
    parser.add_argument(
        '--threads',
        type=int,
        default=None,
        help='Alias of --cores; translated into each tool via flags-translate',
    )
    parser.add_argument(
        '--max-genomes', '--max_genomes', '--top',
        dest='max_genomes',
        type=argparse_max_genomes,
        default=None,
        help='Max taxa for table regenerate and genomes for metagenome generate (default: inf). Alias: --top',
    )
    parser.add_argument(
        '--max-genome-mb',
        dest='max_genome_mb',
        type=argparse_max_genome_mb,
        default=None,
        help='Skip new NCBI downloads larger than this many MB (default: inf; 0 unlimited). Already-cached genomes are kept.',
    )
    parser.add_argument(
        '--genome-skip-list',
        dest='genome_skip_list',
        default=None,
        help='Comma-separated taxids/accessions not to download (already-cached copies are still used)',
    )
    parser.add_argument(
        '--reannotation-level',
        dest='reannotation_level',
        default='taxid',
        help='Genome lookup for table→ISS: taxid/t, species/s, genus/g, family/f, any/a',
    )
    parser.add_argument(
        '--N_reads', '--n_reads', dest='N_reads', type=int, default=None,
        help='Read depth of each regenerated sample (default: 1000, or N_reads in --input_config)')
    parser.add_argument(
        '--N',
        dest='regeneration_n',
        type=int,
        default=None,
        help='Number of synthetic samples for table regeneration (default: same as input)',
    )
    parser.add_argument(
        '--table_reads_generator',
        '--table-reads-generator',
        '--regeneration_mode',
        dest='table_reads_generator',
        action='append',
        default=None,
        help=(
            'Abundance table regenerator: direct|bootstrap|vae|glm|camisim-table|'
            'sparsedossa2-fit|sparsedossa2-stool|samovar, '
            'or a name imported with `samovar tools import --type table`. '
            'Repeat to try several methods; the best is chosen with --table-score'
        ),
    )
    parser.add_argument(
        '--table-score',
        '--table_score',
        '--table-reads-scorer',
        dest='table_score',
        default=None,
        help=(
            'How to pick among multiple --table_reads_generator values '
            '(default: shannon_ks; sparsedossa2_cv if SparseDOSSA2 is installed)'
        ),
    )
    parser.add_argument(
        '--samples-metadata',
        dest='samples_metadata',
        default=None,
        help='Optional samples metadata CSV for custom table regenerators (builtins ignore it)',
    )
    parser.add_argument(
        '--reads_generator',
        '--reads-generator',
        dest='reads_generator',
        default=None,
        help=(
            'Read simulator for generate/prepare: iss|art|wgsim|nanosim|hybrid, '
            'or a name imported with `samovar tools import --type reads`'
        ),
    )
    parser.add_argument(
        '--metagenome_generator',
        '--metagenome-generator',
        dest='metagenome_generator',
        default=None,
        help=(
            'Combined community+reads tool: camisim|hybrid|nanosim, or a name '
            'imported with `samovar tools import --type meta`'
        ),
    )
    parser.add_argument(
        '--scoring',
        action='append',
        default=None,
        help=(
            'Imported scoring/viz tool to run after each viz checkpoint '
            '(repeatable). Default: all custom scoring tools. '
            '`none` disables them. Import with `samovar tools import --type scoring`.'
        ),
    )
    parser.add_argument(
        '--qc',
        dest='qc',
        default=None,
        help=(
            'Imported read QC for both initial and generated FASTQ '
            '(identity when omitted). Native short-read: `fastp` (aliases '
            'illumina/bgi/mgi), `trimmomatic`, `cutadapt`. ONT: `chopper` '
            '(aliases ont/nanopore), `nanofilt`. Import with `--type QC`.'
        ),
    )
    parser.add_argument(
        '--qc-initial',
        dest='qc_initial',
        default=None,
        help='QC tool for initial reads only (overrides --qc)',
    )
    parser.add_argument(
        '--qc-generated',
        dest='qc_generated',
        default=None,
        help='QC tool for generated/regenerated reads only (overrides --qc)',
    )
    parser.add_argument(
        '--qc-postfix',
        dest='qc_postfix',
        action='append',
        default=None,
        help=(
            'Hybrid postfix QC, e.g. --qc-postfix illumina:fastp '
            '--qc-postfix ont:chopper (repeatable). --qc fastp|trimmomatic|cutadapt '
            'fills illumina/bgi/mgi; --qc chopper|nanofilt fills ont.'
        ),
    )
    parser.add_argument(
        '--reprofiler',
        '--ml',
        dest='reprofiler',
        default=None,
        help=(
            'ML reprofiler: ensemble|random_forest|adaboost, or a name imported '
            'with `samovar tools import --type ml`'
        ),
    )
    parser.add_argument(
        '--export',
        '--abundance-corrector',
        '--corrector',
        dest='export_corrector',
        default=None,
        help=(
            'Annotation→abundance export: logistic (default; per-taxon recall '
            'correction), none/identity (raw counts), off (skip), or a name '
            'imported with `samovar tools import --type export`'
        ),
    )
    parser.add_argument(
        '--no-export',
        dest='skip_export',
        action='store_true',
        help='Skip Annotation→abundance export (same as --export off)',
    )
    parser.add_argument(
        '--flags',
        nargs=2,
        action='append',
        metavar=('TOOL', 'FLAGS'),
        dest='tool_flags',
        default=None,
        help=(
            'Extra flags for a tool after import, e.g. '
            '--flags annotator "--foo 1" or '
            '--flags table_reads_generator "--log-mu 1" or '
            '--flags reads_generator "--gc_bias" or '
            '--flags metagenome_generator "--model hiseq" or '
            '--flags scoring "--min-files 1" or '
            '--flags ml "--C 1" or '
            '--flags qc "--min-gc 0.3 --max-gc 0.7" or '
            '--flags export "--min-efficiency 0.05 --C 1"'
        ),
    )
    parser.set_defaults(gzip_genomes=None, gzip_reads=None, reuse_genomes=True)
    gzip_group = parser.add_mutually_exclusive_group()
    gzip_group.add_argument(
        '--gzip-genomes',
        dest='gzip_genomes',
        action='store_const',
        const=True,
        help='Keep downloaded/processed genomes gzip-compressed (default: on)',
    )
    gzip_group.add_argument(
        '--no-gzip-genomes',
        dest='gzip_genomes',
        action='store_const',
        const=False,
        help='Write uncompressed processed FASTA genomes',
    )
    reads_group = parser.add_mutually_exclusive_group()
    reads_group.add_argument(
        '--gzip-reads',
        dest='gzip_reads',
        action='store_const',
        const=True,
        help='Gzip ISS-generated FASTQ after simulation (annotators read .gz)',
    )
    reads_group.add_argument(
        '--no-gzip-reads',
        dest='gzip_reads',
        action='store_const',
        const=False,
        help='Leave simulated FASTQ uncompressed (default)',
    )
    reuse_group = parser.add_mutually_exclusive_group()
    reuse_group.add_argument(
        '--reuse-genomes',
        dest='reuse_genomes',
        action='store_const',
        const=True,
        help='Reuse NCBI/user genomes from config genome_dirs / genomes cache (default)',
    )
    reuse_group.add_argument(
        '--no-reuse-genomes',
        dest='reuse_genomes',
        action='store_const',
        const=False,
        help='Do not reuse library genomes; download into the genomes cache',
    )
    parser.add_argument(
        '--genome-dirs',
        dest='genome_dirs',
        default=None,
        help='Colon-separated extra directories of previously downloaded NCBI genomes',
    )
    parser.add_argument(
        '--index',
        dest='index_dirs',
        nargs='+',
        default=None,
        help='Index processed genomes from these folders (genomes/processed) into the main config',
    )
    parser.add_argument(
        '--test-genomes',
        dest='use_test_genomes',
        action='store_true',
        help='Allow truncated bundled data/test_genomes (ISS/CI only; never for real metagenomes)',
    )
    parser.set_defaults(run_multiqc=None)
    mq_group = parser.add_mutually_exclusive_group()
    mq_group.add_argument(
        '--multiqc',
        dest='run_multiqc',
        action='store_const',
        const=True,
        help='Run MultiQC at the end of exec (default: on if MultiQC is installed)',
    )
    mq_group.add_argument(
        '--no-multiqc',
        dest='run_multiqc',
        action='store_const',
        const=False,
        help='Do not run MultiQC from exec (stage JSON is still written)',
    )
    parser.add_argument(
        '--startpoint',
        '--start-point',
        dest='startpoint',
        default=None,
        help=(
            'First exec checkpoint to run (default: setup_reads). '
            'Aliases: annotate, tables/combine, viz, abundance/otu, '
            'regenerate_tables, score_tables/table_score, genomes, regenerate/iss, '
            'sort, reannotate, ml/reprofile. checkup verifies outdir inputs.'
        ),
    )
    parser.add_argument(
        '--endpoint',
        '--end-point',
        dest='endpoint',
        default=None,
        help=(
            'Last exec checkpoint to run (default: viz_reprofiled). '
            'Example: --startpoint abundance_tables --endpoint score_regenerated_tables'
        ),
    )
    parser.add_argument(
        '--initial-ground-truth-table',
        '--initial-annotation-ground-truth-table',
        dest='initial_ground_truth_table',
        default=None,
        help='CAMI-style seq→taxid table for initial combine (true column)',
    )
    parser.add_argument(
        '--regenerated-metagenomes',
        dest='regenerated_metagenomes',
        default=None,
        help='parse-genome (default: taxid: in headers) or ground-truth-table (grep FASTA >)',
    )
    parser.add_argument(
        '--to',
        dest='export_to',
        action='append',
        default=None,
        help=(
            'Convert every combined annotation table to this format after combine/reprofile '
            '(repeatable, comma-separated). '
            'Formats: cami, mpa (kraken2-style), kraken2/kreport, abundance, annotation'
        ),
    )
    parser.add_argument(
        '--to-mpa',
        dest='to_mpa',
        action='store_true',
        help='Same as --to mpa (Kraken 2 --use-mpa-style reports)',
    )
    parser.add_argument(
        '--to-cami',
        dest='to_cami',
        action='store_true',
        help='Same as --to cami (bioboxes .profile)',
    )
    parser.add_argument(
        '--to-kraken2',
        '--to-kreport',
        dest='to_kraken2',
        action='store_true',
        help='Same as --to kraken2 (kreport)',
    )
    parser.add_argument(
        '--to-abundance',
        dest='to_abundance',
        action='store_true',
        help='Same as --to abundance (taxid × N_sample tables)',
    )
    parser.add_argument(
        '--taxdump',
        dest='export_taxdump',
        default=None,
        help='Taxdump dir for --to kraken2 / mpa / cami (NCBI or GTDB; default: genomes.taxdump / genomes.gtdb)',
    )
    parser.add_argument(
        '--taxonomy',
        dest='export_taxonomy',
        default=None,
        help='Taxonomy for --to kraken2 / mpa / cami: ncbi (default) or gtdb',
    )

    # Parse known args first to get output_dir
    from samovar.tool_spec import parse_known_with_custom

    args, remaining = parse_known_with_custom(parser)
    
    # Check if .generate exists in output_dir
    out_dir = args.output_dir or DEFAULT_OUTPUT_DIR
    generate_dir = Path(out_dir) / ".generate"
    if generate_dir.exists():
        # Add input-dir argument if not already present
        if not args.input_dir:
            args.input_dir = str(Path(out_dir) / "initial")
    
    # Process remaining arguments to handle dynamic command arguments
    # (e.g. --kraken2-test "kraken2 /path/to/db"). Do not treat pipeline
    # flags as annotators if they leak past parse_known_args.
    reserved_cmd = {
        "input_dir", "input_config", "output_dir", "output-dir", "outdir", "directory",
        "cores", "threads",
        "max_genomes", "max-genomes", "top", "max-genome-mb", "max_genome_mb",
        "genome-skip-list", "genome_skip_list",
        "N_reads", "n_reads", "N",
        "genome-dirs", "genome_dirs", "index",
        "reannotation-level", "reannotation_level",
        "table_reads_generator", "table-reads-generator", "regeneration_mode",
        "table-score", "table_score", "table-reads-scorer",
        "samples-metadata", "samples_metadata", "flags",
        "reads_generator", "reads-generator",
        "metagenome_generator", "metagenome-generator",
        "startpoint", "start-point", "endpoint", "end-point",
        "scoring", "reprofiler", "ml",
        "export", "abundance-corrector", "corrector", "no-export",
        "qc", "qc-initial", "qc_initial", "qc-generated", "qc_generated",
        "qc-postfix", "qc_postfix",
        "initial-ground-truth-table", "initial-annotation-ground-truth-table",
        "initial_ground_truth_table", "regenerated-metagenomes", "regenerated_metagenomes",
        "to", "to-mpa", "to-cami", "to-kraken2", "to-kreport", "to-abundance",
        "taxdump", "taxonomy",
    }
    from samovar.tool_spec import load_custom_flags, _norm_flag

    for flag in load_custom_flags():
        reserved_cmd.add(_norm_flag(flag).lstrip("-"))
    cmd_args = {}
    i = 0
    while i < len(remaining):
        if remaining[i].startswith('--'):
            # Get the command name and value
            cmd_name = remaining[i][2:]  # Remove '--' prefix
            if cmd_name in reserved_cmd:
                print(f"Error: unexpected leftover flag {remaining[i]}")
                sys.exit(1)
            if i + 1 < len(remaining):
                cmd_value = remaining[i + 1]
                cmd_args[cmd_name] = cmd_value
                i += 2
            else:
                print(f"Error: Missing value for argument {remaining[i]}")
                sys.exit(1)
        else:
            i += 1
    
    # Add command arguments to args namespace
    for cmd_name, cmd_value in cmd_args.items():
        setattr(args, f'cmd_{cmd_name}', [[cmd_value]])

    index_dirs = getattr(args, "index_dirs", None)
    if index_dirs:
        from samovar.genome_index import index_processed_file, iter_processed_fastas

        counted = 0
        for folder in index_dirs:
            files = iter_processed_fastas(folder)
            if not files:
                print(f"Warning: no processed genomes under {folder}")
                continue
            for path in files:
                index_processed_file(path, move_to=path.parent)
                counted += 1
        print(f"Indexed {counted} processed genome(s) from --index")

    result = setup_pipeline(args)
    print(f"Generated configs: {result['configs']}")
    print(f"Generated pipeline: {result['pipeline']}")

if __name__ == "__main__":
    main() 