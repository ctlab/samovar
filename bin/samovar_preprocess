#!/usr/bin/env python3

import sys
import argparse
from pathlib import Path
from samovar.config import DEFAULT_OUTPUT_DIR, setup_pipeline, parse_args

def main():
    # Get the base parser
    parser = argparse.ArgumentParser(description='SamovaR Pipeline Configuration')
    
    # Input source (mutually exclusive)
    input_group = parser.add_mutually_exclusive_group(required=False)
    input_group.add_argument('--input_config', help='Path to input configuration file', required=False)
    input_group.add_argument('--input_dir', help='Directory containing input FASTQ files', required=False)
    
    # Output
    parser.add_argument('--output_dir', default=None, help='Output directory (default: samovar_out, or from --input_config)')
    parser.add_argument('--cores', type=int, default=1, help='Number of cores for snakemake / annotator threads')
    parser.add_argument(
        '--max_genomes', type=int, default=50,
        help='Max taxids to fetch for annotation2iss (top by abundance)')
    parser.add_argument(
        '--reannotation-level',
        dest='reannotation_level',
        default='taxid',
        help='Genome lookup for table→ISS: taxid/t, species/s, genus/g, family/f, any/a',
    )
    parser.add_argument(
        '--N_reads', '--n_reads', dest='N_reads', type=int, default=None,
        help='Read depth of each regenerated sample (default: 1000, or N_reads in --input_config)')
    parser.add_argument(
        '--table_reads_generator',
        '--table-reads-generator',
        '--regeneration_mode',
        dest='table_reads_generator',
        default=None,
        help=(
            'Abundance table regenerator: direct|bootstrap|vae|glm|camisim-table|samovar, '
            'or a name imported with `samovar tools import --type table`'
        ),
    )
    parser.add_argument(
        '--samples-metadata',
        dest='samples_metadata',
        default=None,
        help='Optional samples metadata CSV for custom table regenerators (builtins ignore it)',
    )
    parser.add_argument(
        '--reads_generator',
        '--reads-generator',
        dest='reads_generator',
        default=None,
        help=(
            'Read simulator for generate/prepare: iss|art|wgsim|nanosim|hybrid, '
            'or a name imported with `samovar tools import --type reads`'
        ),
    )
    parser.add_argument(
        '--metagenome_generator',
        '--metagenome-generator',
        dest='metagenome_generator',
        default=None,
        help=(
            'Combined community+reads tool: camisim|hybrid|nanosim, or a name '
            'imported with `samovar tools import --type meta`'
        ),
    )
    parser.add_argument(
        '--scoring',
        action='append',
        default=None,
        help=(
            'Imported scoring/viz tool to run after each viz checkpoint '
            '(repeatable). Default: all custom scoring tools. '
            '`none` disables them. Import with `samovar tools import --type scoring`.'
        ),
    )
    parser.add_argument(
        '--reprofiler',
        '--ml',
        dest='reprofiler',
        default=None,
        help=(
            'ML reprofiler: ensemble|random_forest|adaboost, or a name imported '
            'with `samovar tools import --type ml`'
        ),
    )
    parser.add_argument(
        '--flags',
        nargs=2,
        action='append',
        metavar=('TOOL', 'FLAGS'),
        dest='tool_flags',
        default=None,
        help=(
            'Extra flags for a tool after import, e.g. '
            '--flags annotator "--foo 1" or '
            '--flags table_reads_generator "--log-mu 1" or '
            '--flags reads_generator "--gc_bias" or '
            '--flags metagenome_generator "--model hiseq" or '
            '--flags scoring "--min-files 1" or '
            '--flags ml "--C 1"'
        ),
    )
    parser.set_defaults(gzip_genomes=None, gzip_reads=None, reuse_genomes=True)
    gzip_group = parser.add_mutually_exclusive_group()
    gzip_group.add_argument(
        '--gzip-genomes',
        dest='gzip_genomes',
        action='store_const',
        const=True,
        help='Keep downloaded/processed genomes gzip-compressed (default: on)',
    )
    gzip_group.add_argument(
        '--no-gzip-genomes',
        dest='gzip_genomes',
        action='store_const',
        const=False,
        help='Write uncompressed processed FASTA genomes',
    )
    reads_group = parser.add_mutually_exclusive_group()
    reads_group.add_argument(
        '--gzip-reads',
        dest='gzip_reads',
        action='store_const',
        const=True,
        help='Gzip ISS-generated FASTQ after simulation (annotators read .gz)',
    )
    reads_group.add_argument(
        '--no-gzip-reads',
        dest='gzip_reads',
        action='store_const',
        const=False,
        help='Leave simulated FASTQ uncompressed (default)',
    )
    reuse_group = parser.add_mutually_exclusive_group()
    reuse_group.add_argument(
        '--reuse-genomes',
        dest='reuse_genomes',
        action='store_const',
        const=True,
        help='Reuse NCBI/user genomes from config genome_dirs / genomes cache (default)',
    )
    reuse_group.add_argument(
        '--no-reuse-genomes',
        dest='reuse_genomes',
        action='store_const',
        const=False,
        help='Do not reuse library genomes; download into the genomes cache',
    )
    parser.add_argument(
        '--genome-dirs',
        dest='genome_dirs',
        default=None,
        help='Colon-separated extra directories of previously downloaded NCBI genomes',
    )
    parser.add_argument(
        '--index',
        dest='index_dirs',
        nargs='+',
        default=None,
        help='Index processed genomes from these folders (genomes/processed) into the main config',
    )
    parser.add_argument(
        '--test-genomes',
        dest='use_test_genomes',
        action='store_true',
        help='Allow truncated bundled data/test_genomes (ISS/CI only; never for real metagenomes)',
    )
    parser.set_defaults(run_multiqc=None)
    mq_group = parser.add_mutually_exclusive_group()
    mq_group.add_argument(
        '--multiqc',
        dest='run_multiqc',
        action='store_const',
        const=True,
        help='Run MultiQC at the end of exec (default: on if MultiQC is installed)',
    )
    mq_group.add_argument(
        '--no-multiqc',
        dest='run_multiqc',
        action='store_const',
        const=False,
        help='Do not run MultiQC from exec (stage JSON is still written)',
    )
    parser.add_argument(
        '--startpoint',
        '--start-point',
        dest='startpoint',
        default=None,
        help=(
            'First exec checkpoint to run (default: setup_reads). '
            'Aliases: annotate, tables/combine, viz, genomes, regenerate/iss, '
            'sort, reannotate, ml/reprofile. Custom start checks outdir inputs.'
        ),
    )
    parser.add_argument(
        '--endpoint',
        '--end-point',
        dest='endpoint',
        default=None,
        help=(
            'Last exec checkpoint to run (default: viz_reprofiled). '
            'Example: --startpoint tables --endpoint viz_initial'
        ),
    )

    # Parse known args first to get output_dir
    args, remaining = parser.parse_known_args()
    
    # Check if .generate exists in output_dir
    out_dir = args.output_dir or DEFAULT_OUTPUT_DIR
    generate_dir = Path(out_dir) / ".generate"
    if generate_dir.exists():
        # Add input-dir argument if not already present
        if not args.input_dir:
            args.input_dir = str(Path(out_dir) / "initial")
    
    # Process remaining arguments to handle dynamic command arguments
    # (e.g. --kraken2-test "kraken2 /path/to/db"). Do not treat pipeline
    # flags as annotators if they leak past parse_known_args.
    reserved_cmd = {
        "input_dir", "input_config", "output_dir", "cores", "max_genomes",
        "N_reads", "n_reads", "genome-dirs", "genome_dirs", "index",
        "reannotation-level", "reannotation_level",
        "table_reads_generator", "table-reads-generator", "regeneration_mode",
        "samples-metadata", "samples_metadata", "flags",
        "reads_generator", "reads-generator",
        "metagenome_generator", "metagenome-generator",
        "startpoint", "start-point", "endpoint", "end-point",
    }
    cmd_args = {}
    i = 0
    while i < len(remaining):
        if remaining[i].startswith('--'):
            # Get the command name and value
            cmd_name = remaining[i][2:]  # Remove '--' prefix
            if cmd_name in reserved_cmd:
                print(f"Error: unexpected leftover flag {remaining[i]}")
                sys.exit(1)
            if i + 1 < len(remaining):
                cmd_value = remaining[i + 1]
                cmd_args[cmd_name] = cmd_value
                i += 2
            else:
                print(f"Error: Missing value for argument {remaining[i]}")
                sys.exit(1)
        else:
            i += 1
    
    # Add command arguments to args namespace
    for cmd_name, cmd_value in cmd_args.items():
        setattr(args, f'cmd_{cmd_name}', [[cmd_value]])

    index_dirs = getattr(args, "index_dirs", None)
    if index_dirs:
        from samovar.genome_index import index_processed_file, iter_processed_fastas

        counted = 0
        for folder in index_dirs:
            files = iter_processed_fastas(folder)
            if not files:
                print(f"Warning: no processed genomes under {folder}")
                continue
            for path in files:
                index_processed_file(path, move_to=path.parent)
                counted += 1
        print(f"Indexed {counted} processed genome(s) from --index")

    result = setup_pipeline(args)
    print(f"Generated configs: {result['configs']}")
    print(f"Generated pipeline: {result['pipeline']}")

if __name__ == "__main__":
    main() 