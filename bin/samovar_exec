#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${SAMOVAR_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
PYTHON="${PYTHON_PATH:-python3}"
ORIG_ARGS=("$@")

_is_custom_flag() {
    PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
        "$PYTHON" -c "
from samovar.tool_spec import load_custom_flags, _norm_flag
import sys
flag = sys.argv[1].split('=', 1)[0]
raise SystemExit(0 if _norm_flag(flag) in load_custom_flags() else 1)
" "$1" 2>/dev/null
}

# Parse arguments
OUTPUT_DIR="."
export SAMOVAR_REDO="${SAMOVAR_REDO:-0}"
export SAMOVAR_CLEANUP_TMP="${SAMOVAR_CLEANUP_TMP:-0}"
while [[ $# -gt 0 ]]; do
    case $1 in
        --output_dir|--output-dir|--outdir|--directory)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        --output_dir=*|--output-dir=*|--outdir=*|--directory=*)
            OUTPUT_DIR="${1#*=}"
            shift
            ;;
        --redo)
            export SAMOVAR_REDO=1
            shift
            ;;
        --startpoint|--start-point)
            export SAMOVAR_START="$2"
            shift 2
            ;;
        --endpoint|--end-point)
            export SAMOVAR_END="$2"
            shift 2
            ;;
        --cleanup-tmp)
            export SAMOVAR_CLEANUP_TMP=1
            shift
            ;;
        --no-cleanup-tmp)
            export SAMOVAR_CLEANUP_TMP=0
            shift
            ;;
        -h|--help)
            echo "Usage: samovar exec --directory /path/to/output [--redo] [--cleanup-tmp] [--startpoint STEP] [--endpoint STEP]"
            echo ""
            echo "  --directory / --output_dir / --outdir   Run directory (default: .)"
            echo "  --redo          Ignore completed checkpoints and rerun every exec step"
            echo "  --startpoint    First checkpoint to run (overrides prepare; aliases: tables, viz, ml, …)"
            echo "  --endpoint      Last checkpoint to run (e.g. combine_initial / tables)"
            echo "  --cleanup-tmp   After a successful run, remove .tmp / ISS scratch dirs"
            echo "  --no-cleanup-tmp  Keep temporary directories (default)"
            echo "  Custom-flags from the install config (e.g. --threads) are accepted and ignored here;"
            echo "  they are applied at prepare/generate via flags-translate."
            exit 0
            ;;
        *)
            if _is_custom_flag "$1"; then
                if [[ "$1" == *=* ]]; then
                    shift
                elif [[ $# -gt 1 && "$2" != -* ]]; then
                    shift 2
                else
                    shift
                fi
                continue
            fi
            echo "Unknown option: $1"
            echo "Usage: samovar exec --directory /path/to/output [--redo] [--cleanup-tmp] [--startpoint STEP] [--endpoint STEP]"
            exit 1
            ;;
    esac
done

_cli_start="${SAMOVAR_START:-}"
_cli_end="${SAMOVAR_END:-}"
if [ -f "$OUTPUT_DIR/.log/window.env" ]; then
    # shellcheck disable=SC1091
    . "$OUTPUT_DIR/.log/window.env"
fi
[ -n "$_cli_start" ] && export SAMOVAR_START="$_cli_start"
[ -n "$_cli_end" ] && export SAMOVAR_END="$_cli_end"

_cleanup_tmp_if_requested() {
    if [ "${SAMOVAR_CLEANUP_TMP:-0}" = "0" ]; then
        return 0
    fi
    echo "Cleaning temporary directories under $OUTPUT_DIR..."
    PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
        "$PYTHON" -m samovar.exec_control cleanup "$OUTPUT_DIR" || true
}

if [ "${SAMOVAR_REDO:-0}" != "0" ]; then
    echo "Clearing pipeline checkpoints (--redo)"
    PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
        "$PYTHON" -m samovar.exec_control clear "$OUTPUT_DIR" || \
        rm -f "$OUTPUT_DIR/.log/checkpoints/"*.done 2>/dev/null || true
fi

# Check for .generate directory and run its pipeline if it exists.
# Skip when the exec window starts after setup_reads, or when initial/ already
# has reads (CAMISIM Nextflow is slow to redo) unless --redo / SAMOVAR_REDO=1.
if [ -d "$OUTPUT_DIR/.generate" ] && [ -f "$OUTPUT_DIR/.generate/generate.sh" ]; then
    if [ -n "${SAMOVAR_START:-}" ] && ! PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
        "$PYTHON" -m samovar.exec_control active setup_reads; then
        echo "Skipping generate: startpoint ${SAMOVAR_START} is after setup_reads"
    elif [ "${SAMOVAR_REDO:-0}" = "0" ] && PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
        "$PYTHON" -c "from samovar.seqio import has_r1_reads; raise SystemExit(0 if has_r1_reads(r'''$OUTPUT_DIR/initial''') else 1)"; then
        echo "Skipping generate: $OUTPUT_DIR/initial already has reads (use --redo to regenerate)"
    else
        echo "Running generate pipeline..."
        bash "$OUTPUT_DIR/.generate/generate.sh" --directory "$OUTPUT_DIR"
    fi
fi

# Check for .log directory and run its pipeline if it exists
if [ -d "$OUTPUT_DIR/.log" ] && [ -f "$OUTPUT_DIR/.log/samovar.sh" ]; then
    echo "Running main SamovaR pipeline..."
    bash "$OUTPUT_DIR/.log/samovar.sh" --directory "$OUTPUT_DIR"
else
    echo "Error: $OUTPUT_DIR/.log/samovar.sh is missing."
    echo "Generate only writes reads under $OUTPUT_DIR/initial/."
    echo "Continue with prepare, then exec, for example:"
    echo "  samovar prepare --output_dir $OUTPUT_DIR --test-genomes \\"
    echo "    --kraken2-test 'kraken2 /path/to/kraken2_db' \\"
    echo "    --kaiju-test 'kaiju /path/to/kaiju_db'"
    echo "  samovar exec --output_dir $OUTPUT_DIR"
    exit 1
fi

_cleanup_tmp_if_requested

PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
    "$PYTHON" -m samovar.repro record exec --output_dir "$OUTPUT_DIR" -- "${ORIG_ARGS[@]}" || true

echo "Pipeline execution completed."
