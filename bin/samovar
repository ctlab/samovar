#!/bin/bash
# SamovaR CLI. Does not require the current directory to be the repo root.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

_has_run_dir() {
    local a
    for a in "$@"; do
        case "$a" in
            --output_dir|--output-dir|--outdir|--directory|-o|-d) return 0 ;;
            --output_dir=*|--output-dir=*|--outdir=*|--directory=*|-o=*|-d=*) return 0 ;;
        esac
    done
    return 1
}

_find_cfg() {
    if [ -n "${SAMOVAR_CONFIG:-}" ] && [ -f "$SAMOVAR_CONFIG" ]; then
        echo "$SAMOVAR_CONFIG"
        return
    fi
    if [ -f "$SCRIPT_DIR/../build/config_path" ]; then
        _ptr="$(cat "$SCRIPT_DIR/../build/config_path")"
        if [ -n "$_ptr" ] && [ -f "$_ptr" ]; then
            echo "$_ptr"
            return
        fi
    fi
    if [ -f "$XDG_CONFIG_HOME/samovar/config.json" ]; then
        echo "$XDG_CONFIG_HOME/samovar/config.json"
        return
    fi
    if [ -f "$SCRIPT_DIR/../build/config.json" ]; then
        echo "$SCRIPT_DIR/../build/config.json"
        return
    fi
    return 1
}

_samovar_version() {
    local root pyproject ver
    root="${SAMOVAR_ROOT:-$SCRIPT_DIR/..}"
    pyproject="$root/pyproject.toml"
    ver=""
    if [ -f "$pyproject" ]; then
        ver="$(
            grep -E '^version[[:space:]]*=' "$pyproject" 2>/dev/null \
                | head -n1 \
                | sed -E 's/^version[[:space:]]*=[[:space:]]*["'\'']([^"'\'']+)["'\''].*/\1/'
        )"
    fi
    if [ -z "$ver" ] && [ -x "${PYTHON_PATH:-}" ]; then
        ver="$(
            PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}" \
                "$PYTHON_PATH" -c 'from samovar.version import get_version; print(get_version())' 2>/dev/null || true
        )"
    fi
    printf '%s\n' "${ver:-unknown}"
}

show_usage() {
    echo "SAMOVAR $(_samovar_version)"
    echo ""
    echo "Usage: samovar [command] [options]"
    echo "       samovar -h | --help | help"
    echo ""
    echo "Commands:"
    echo "  prepare     Generate main pipeline configuration (alias: preprocess)"
    echo "  build       Build Kaiju or Kraken2 database from config (alias: build_database)"
    echo "  exec        Execute the pipeline(s) (resumes from checkpoints; --redo reruns all)"
    echo "              Optional --startpoint / --endpoint slice the run (same names as prepare)"
    echo "  checkup     Verify outdir has inputs for --start-point (does not run the pipeline)"
    echo "  branch      Copy a run up to --start-point; prepare in the copy continues from there"
    echo "  multiqc     Run the real MultiQC CLI on staged *_mqc files (pass-through after --)"
    echo "  generate    Generate ISS or CAMISIM test configuration and pipeline"
    echo "  tools       import a binary; --sort reads; --status (same as import status)"
    echo "  import      Alias of tools import"
    echo "  export      Pack a Hydra run snapshot (+ optional databases) into an archive"
    echo "  reproduce   Reinstall locked tools if needed and re-run generate/prepare/exec"
    echo "  genome      Download FASTA by accession or taxid (genome download)"
    echo "  reindex     Move processed genomes into samovar_database and update the install config"
    echo "  update      Update the installed checkout (its current branch) and reinstall"
    echo "  convert     Convert Annotation (abundance, kraken2, CAMI, or a custom converter)"
    echo "  apply       Apply a completed pipeline to one new sample (optional --full to refit)"
    echo "  merge       Combine two or more run directories (modes: initial, regenerated)"
    echo "  methods     Write methods.md from a prepared run (alias: samovar-method)"
    echo "  help        Show this help message (also: -h, --help)"
    echo ""
    echo "Examples:"
    echo "  samovar generate --genome_dir [...] --directory [...] --host_genome [...]"
    echo "  samovar generate --simulator camisim --camisim-mode table --outdir samovar/camisim-table ..."
    echo "  samovar prepare --input_dir [...] --directory [...] --cores 16 --mem 16G"
    echo "  samovar prepare --to-mpa --to-cami --directory [...]"
    echo "  samovar checkup --start-point abundance_tables --outdir [...]"
    echo "  samovar prepare --startpoint abundance_tables --endpoint score_regenerated_tables --directory [...]"
    echo "  samovar prepare --initial-ground-truth-table mapping.tsv --regenerated-metagenomes parse-genome"
    echo "  samovar prepare --regenerated-metagenomes ground-truth-table --directory [...]"
    echo "  samovar build --type kaiju --config_path [...] --db_path [...]"
    echo "  samovar exec --directory [...]"
    echo "  samovar exec --output_dir [...] --redo"
    echo "  samovar exec --outdir [...] --cleanup-tmp"
    echo "  samovar prepare --add-annotator --kraken2-test 'kraken2 toy' --directory [...]"
    echo "  samovar branch --start-point regenerate_tables /path/run /path/run_branch"
    echo "  samovar multiqc --output_dir [...] -- --export"
    echo "  samovar import status"
    echo "  samovar tools import -n kaiju --exec kaiju --exec-path /usr/bin/kaiju --type annotator --lazy-install 'conda install bioconda::kaiju'"
    echo "  samovar tools import -n standard_8GB --type database --tool kraken2 --exec-path /path/to/db --lazy-download @fetch.sh"
    echo "  samovar export /path/to/run -o run.tgz --config full"
    echo "  samovar reproduce run.tgz --output_dir /path/to/rerun"
    echo "  samovar reproduce run.tgz --output_dir /path/to/rerun --stages generate generate.n_samples=2"
    echo "  samovar tools --sort --output_dir [...]"
    echo "  samovar genome download --output-dir genomes GCF_000819615.1 562"
    echo "  samovar generate --accessions GCF_... --reindex 1 --output_dir [...]"
    echo "  samovar convert -i initial_annotations -o counts --to abundance"
    echo "  samovar convert -i initial_annotations -o reports --to kraken2"
    echo "  samovar convert -i initial_annotations -o profiles --to cami --taxonomy gtdb"
    echo "  samovar convert -i table.csv --from abundance --to annotation -o long.csv"
    echo "  samovar apply --input_dir new_fastq --pipeline samovar_out --output_dir apply_out --cores 8 --mem 16G"
    echo "  samovar apply --input_dir new_fastq --pipeline samovar_out --output_dir apply_full --full"
    echo "  samovar merge --mode initial --output_dir merged_init run_a run_b"
    echo "  samovar merge --mode regenerated --output_dir merged_regen run_a run_b"
    echo "  samovar methods --output_dir RUN"
    echo "  samovar update"
    echo "  samovar update --auto"
    echo "  samovar update --branch main"
    echo "  samovar build --type kaiju --config_path [...] --db_path [...] --index phage_test"
}

if [ "${1:-help}" = "help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    SAMOVAR_ROOT="$SCRIPT_DIR/.." show_usage
    exit 0
fi

CFG=""
if CFG="$(_find_cfg)"; then
    :
else
    if [ "${1:-}" = "update" ]; then
        ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
        export SAMOVAR_ROOT="$ROOT"
        shift
        exec "$SCRIPT_DIR/samovar_update" "$@"
    fi
    if [ "${1:-}" = "help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ -z "${1:-}" ]; then
        ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
        export SAMOVAR_ROOT="$ROOT"
        show_usage
        exit 0
    fi
    echo "Error: SamovaR is not installed (no ~/.config/samovar/config.json or build/config.json)."
    echo "Run ./install.sh from the SamovaR source tree."
    exit 1
fi

# A PATH Python may belong to a classifier env. The OS interpreter only reads
# the JSON schema; it never imports SAMOVAR or runs application commands.
BOOTSTRAP=""
for candidate in /usr/bin/python3 /usr/local/bin/python3; do
    if [ -x "$candidate" ]; then BOOTSTRAP="$candidate"; break; fi
done
_CALLER_PATH="$PATH"
if [ -f "$(dirname "$CFG")/env" ]; then
    . "$(dirname "$CFG")/env"
fi
# Older install env files prepend every classifier env; keep the caller's PATH.
export PATH="$_CALLER_PATH"
unset _CALLER_PATH
if [ -z "$BOOTSTRAP" ] && [ -x "${PYTHON_PATH:-}" ]; then
    BOOTSTRAP="$PYTHON_PATH"
fi
if [ -z "$BOOTSTRAP" ]; then
    echo "Cannot read the SAMOVAR config: no bootstrap interpreter. Run install.sh." >&2
    exit 1
fi
export SAMOVAR_CONFIG="$CFG"
runtime_exports="$("$BOOTSTRAP" "$SCRIPT_DIR/../src/samovar/main_config.py" "$CFG" "$SCRIPT_DIR/..")"
eval "$runtime_exports"
ROOT="$SAMOVAR_ROOT"
PYTHON="$PYTHON_PATH"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

case "${1:-}" in
    "_runtime-env")
        "$PYTHON" -c 'from samovar.paths import shell_runtime_exports; print(shell_runtime_exports())'
        ;;
    "generate")
        shift
        "$PYTHON" "$SCRIPT_DIR/samovar_generate" "$@"
        ;;
    "prepare"|"preprocess")
        shift
        "$PYTHON" "$SCRIPT_DIR/samovar_preprocess" "$@"
        ;;
    "exec")
        shift
        if ! _has_run_dir "$@"; then
            set -- "$@" "--directory" "."
        fi
        "$SCRIPT_DIR/samovar_exec" "$@"
        ;;
    "checkup")
        shift
        PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
            "$PYTHON" -m samovar.exec_control checkup "$@"
        ;;
    "branch")
        shift
        PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
            "$PYTHON" -m samovar.branch "$@"
        ;;
    "multiqc")
        shift
        if ! _has_run_dir "$@"; then
            set -- "$@" "--directory" "."
        fi
        OUT="."
        EXTRA=()
        while [[ $# -gt 0 ]]; do
            case $1 in
                --output_dir|--output-dir|--outdir|--directory|-o|-d)
                    OUT="$2"
                    shift 2
                    ;;
                --output_dir=*|--output-dir=*|--outdir=*|--directory=*|-o=*|-d=*)
                    OUT="${1#*=}"
                    shift
                    ;;
                *)
                    EXTRA+=("$1")
                    shift
                    ;;
            esac
        done
        PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
            "$PYTHON" -m samovar.stage_report multiqc "$OUT" "${EXTRA[@]}"
        ;;
    "tools")
        shift
        case "${1:-}" in
            "import")
                shift
                PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
                    "$PYTHON" -m samovar.tools_import "$@"
                ;;
            "--sort")
                shift
                "$PYTHON" "$SCRIPT_DIR/samovar_sort_reads" "$@"
                ;;
            "--status"|"status")
                PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
                    "$PYTHON" -m samovar.tools_import status
                ;;
            "help"|"-h"|"--help"|"")
                echo "Usage: samovar tools <command>"
                echo "  import     Register a binary or database"
                echo "  --status   Same report as: samovar import status"
                echo "  --sort     Sort paired FASTQ by read ID"
                echo "See wiki/tools_import.md"
                ;;
            *)
                echo "Error: Unknown tool '${1:-}'"
                echo "Available: import  --sort  --status"
                exit 1
                ;;
        esac
        ;;
    "import")
        shift
        PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
            "$PYTHON" -m samovar.tools_import "$@"
        ;;
    "export")
        shift
        PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
            "$PYTHON" -m samovar.repro export "$@"
        ;;
    "reproduce")
        shift
        PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
            "$PYTHON" -m samovar.repro reproduce "$@"
        ;;
    "build"|"build_database")
        shift
        "$ROOT/workflow/database_prep/samovar_build_database.sh" "$@"
        ;;
    "convert")
        shift
        PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
            "$PYTHON" -m samovar.annotation_convert "$@"
        ;;
    "apply")
        shift
        "$PYTHON" "$SCRIPT_DIR/samovar_apply" "$@"
        ;;
    "merge")
        shift
        "$PYTHON" "$SCRIPT_DIR/samovar_merge" "$@"
        ;;
    "methods"|"samovar-method")
        shift
        PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
            "$PYTHON" -m samovar.methods "$@"
        ;;
    "genome")
        shift
        case "${1:-}" in
            download)
                shift
                PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
                    "$PYTHON" -c 'import sys; from samovar.genome_fetcher import download_cli; raise SystemExit(download_cli(sys.argv[1:]))' "$@"
                ;;
            help|-h|--help|"")
                echo "Usage: samovar genome download [--output-dir DIR] ACCESSION_OR_TAXID ..."
                echo "  samovar genome download --output-dir genomes GCF_000819615.1 562"
                ;;
            *)
                echo "Error: Unknown genome command '${1:-}'"
                echo "Usage: samovar genome download [--output-dir DIR] ACCESSION_OR_TAXID ..."
                exit 1
                ;;
        esac
        ;;
    "reindex")
        shift
        "$PYTHON" "$SCRIPT_DIR/samovar_reindex" "$@"
        ;;
    "update")
        shift
        exec "$SCRIPT_DIR/samovar_update" "$@"
        ;;
    "help"|"-h"|"--help"|"")
        show_usage
        ;;
    *)
        echo "Error: Unknown command '$1'"
        show_usage
        exit 1
        ;;
esac
