#!/usr/bin/env python3

import argparse
from pathlib import Path

from samovar.seqio import (
    iter_fastq_records,
    list_r1_files,
    open_text,
    r2_for_r1,
)


def read_fastq_records(path: Path):
    records = []
    for h, s, p, q in iter_fastq_records(path):
        key = h.split()[0].replace("/1", "").replace("/2", "")
        records.append((key, h, s, p, q))
    return records


def write_fastq_records(path: Path, records):
    with open_text(path, "wt") as fh:
        for _, h, s, p, q in records:
            fh.write(h)
            fh.write(s)
            fh.write(p)
            fh.write(q)


def sort_paired_files(r1_path: Path, r2_path: Path):
    r1 = sorted(read_fastq_records(r1_path), key=lambda x: x[0])
    r2 = sorted(read_fastq_records(r2_path), key=lambda x: x[0])
    write_fastq_records(r1_path, r1)
    write_fastq_records(r2_path, r2)


def _r1_files(out_dir: Path):
    seen = set()
    files = []
    for directory in (out_dir, out_dir / "regenerated", out_dir / "initial"):
        if not directory.is_dir():
            continue
        for r1 in list_r1_files(directory):
            key = str(r1.resolve())
            if key not in seen:
                seen.add(key)
                files.append(r1)
    return files


def main():
    parser = argparse.ArgumentParser(description="Sort paired FASTQ files by read ID")
    from samovar.paths import add_output_dir_argument

    add_output_dir_argument(parser, default=".", help="Directory with FASTQ files")
    parser.add_argument("output_dir_pos", nargs="?", help="Optional positional output_dir")
    from samovar.tool_spec import parse_known_with_custom

    args, leftover = parse_known_with_custom(parser)
    if leftover:
        parser.error("unrecognized arguments: " + " ".join(leftover))

    out_dir = Path(args.output_dir_pos or args.output_dir)
    if not out_dir.exists():
        raise SystemExit(f"Output directory not found: {out_dir}")

    for r1_path in _r1_files(out_dir):
        r2_path = r2_for_r1(r1_path)
        if r2_path.exists():
            sort_paired_files(r1_path, r2_path)


if __name__ == "__main__":
    main()
