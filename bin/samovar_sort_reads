#!/usr/bin/env python3

import argparse
from pathlib import Path


def read_fastq_records(path: Path):
    records = []
    with path.open("r", encoding="utf-8") as fh:
        while True:
            h = fh.readline()
            if not h:
                break
            s = fh.readline()
            p = fh.readline()
            q = fh.readline()
            if not (s and p and q):
                break
            key = h.split()[0].replace("/1", "").replace("/2", "")
            records.append((key, h, s, p, q))
    return records


def write_fastq_records(path: Path, records):
    with path.open("w", encoding="utf-8") as fh:
        for _, h, s, p, q in records:
            fh.write(h)
            fh.write(s)
            fh.write(p)
            fh.write(q)


def sort_paired_files(r1_path: Path, r2_path: Path):
    r1 = sorted(read_fastq_records(r1_path), key=lambda x: x[0])
    r2 = sorted(read_fastq_records(r2_path), key=lambda x: x[0])
    write_fastq_records(r1_path, r1)
    write_fastq_records(r2_path, r2)


def main():
    parser = argparse.ArgumentParser(description="Sort paired FASTQ files by read ID")
    parser.add_argument("--output_dir", default=".", help="Directory with FASTQ files")
    parser.add_argument("output_dir_pos", nargs="?", help="Optional positional output_dir")
    args = parser.parse_args()

    out_dir = Path(args.output_dir_pos or args.output_dir)
    if not out_dir.exists():
        raise SystemExit(f"Output directory not found: {out_dir}")

    r1_files = sorted(out_dir.glob("*_R1.fastq"))
    for r1_path in r1_files:
        r2_path = out_dir / r1_path.name.replace("_R1.fastq", "_R2.fastq")
        if r2_path.exists():
            sort_paired_files(r1_path, r2_path)


if __name__ == "__main__":
    main()
