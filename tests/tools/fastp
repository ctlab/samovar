#!/usr/bin/env python3
"""CLI stub matching SamovaR's native fastp invocation (``-i/-I`` in, ``-o/-O`` out)."""
from __future__ import annotations

import json
import shutil
import sys
from pathlib import Path


def main(argv: list[str]) -> int:
    args = list(argv)
    dest_r1 = dest_r2 = src_r1 = src_r2 = json_path = html_path = ""
    i = 0
    while i < len(args):
        tok = args[i]
        key, _, attached = tok.partition("=")
        if key in {"-i", "-I", "-o", "-O", "-h", "-j", "-w", "--thread", "--threads",
                   "--html", "--json", "--length_required", "--qualified_quality_phred"}:
            val = attached
            if not val:
                i += 1
                if i >= len(args):
                    break
                val = args[i]
            if key == "-i":
                src_r1 = val
            elif key == "-I":
                src_r2 = val
            elif key == "-o":
                dest_r1 = val
            elif key == "-O":
                dest_r2 = val
            elif key in {"-j", "--json"}:
                json_path = val
            elif key in {"-h", "--html"}:
                html_path = val
            i += 1
            continue
        if tok.startswith("-"):
            if i + 1 < len(args) and not args[i + 1].startswith("-"):
                i += 2
            else:
                i += 1
            continue
        i += 1
    if not src_r1 or not dest_r1:
        print("fastp stub: expected -i R1 -o DEST [-I R2 -O DEST2]", file=sys.stderr)
        return 2
    shutil.copy2(src_r1, dest_r1)
    if src_r2 and dest_r2:
        shutil.copy2(src_r2, dest_r2)
    if json_path:
        Path(json_path).write_text(json.dumps({"stub": True, "summary": {}}) + "\n")
    if html_path:
        Path(html_path).write_text("<html></html>\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
