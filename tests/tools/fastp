#!/usr/bin/env python3
"""Native fastp CLI stub for QC contract tests (copy reads; no filtering)."""

from __future__ import annotations

import sys
from pathlib import Path
import shutil


def _value(argv: list, *flags: str) -> str:
    for i, tok in enumerate(argv):
        if tok in flags and i + 1 < len(argv):
            return argv[i + 1]
    return ""


def main(argv: list | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    r1 = _value(args, "-i")
    r2 = _value(args, "-I")
    o1 = _value(args, "-o")
    o2 = _value(args, "-O")
    html = _value(args, "-h")
    json_path = _value(args, "-j")
    if not r1 or not o1:
        print("fastp stub needs -i and -o", file=sys.stderr)
        return 2
    Path(o1).parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(r1, o1)
    if r2 and o2:
        Path(o2).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(r2, o2)
    if html:
        Path(html).write_text("<html>fastp</html>\n", encoding="utf-8")
    if json_path:
        Path(json_path).write_text("{}\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
